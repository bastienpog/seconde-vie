FROM php:8.3-fpm-alpine

WORKDIR /var/www/html

ENV APP_ENV=prod
ENV APP_DEBUG=0

RUN printf '%s\n' 'variables_order = "EGPCS"' > /usr/local/etc/php/conf.d/99-symfony-env.ini \
    && printf '%s\n' '[www]' 'clear_env = no' > /usr/local/etc/php-fpm.d/zz-env.conf

RUN apk add --no-cache \
    bash \
    curl \
    git \
    icu-dev \
    libzip-dev \
    libxml2-dev \
    mysql-client \
    nginx \
    oniguruma-dev \
    unzip

RUN docker-php-ext-install \
    intl \
    mbstring \
    opcache \
    pdo \
    pdo_mysql \
    xml \
    zip

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY . .
COPY docker/nginx-prod.conf /etc/nginx/http.d/default.conf
COPY docker-entrypoint-prod.sh /usr/local/bin/seconde-vie-prod-entrypoint

RUN printf '%s\n' 'APP_ENV=prod' 'APP_DEBUG=0' > .env

RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --no-scripts \
    && mkdir -p config/jwt var/cache var/log \
    && chown -R www-data:www-data var config/jwt \
    && chmod +x /usr/local/bin/seconde-vie-prod-entrypoint

EXPOSE 8080

ENTRYPOINT ["seconde-vie-prod-entrypoint"]
CMD ["nginx"]
